---
import { Image } from 'astro:assets';
import eeveeMew from '../assets/eevee-mew.png';
---

<footer>
  <div class="ilustracion">
    <Image src={eeveeMew} alt="" width={300} loading="lazy" />
  </div>
  <p class="aviso">Esta entrada es única, personal e intransferible.</p>
  <p class="firma">LUCÍA &amp; MANUEL · 26.12.2026</p>
</footer>

<style>
  footer {
    position: relative;
    padding: 8px 28px 40px;
    text-align: center;
  }

  .ilustracion {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .ilustracion :global(img) {
    display: block;
    width: 150px;
    height: auto;
    mix-blend-mode: multiply;
  }

  .aviso {
    margin: 0;
    font-family: var(--script);
    font-size: 22px;
    line-height: 1.3;
    color: var(--dorado-oscuro);
  }

  .firma {
    margin: 14px 0 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado);
  }
</style>
