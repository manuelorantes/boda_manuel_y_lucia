---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { GIMNASIOS } from '../data/pokedex';

// Las ilustraciones se importan por glob y no una a una: asi un gimnasio cuya
// imagen todavia no este en src/assets se queda sin dibujo en vez de romper el
// build, igual que hace el comic de "Nuestra historia".
const dibujos = import.meta.glob<{ default: ImageMetadata }>('../assets/*.png', { eager: true });

const gimnasios = GIMNASIOS.map((g) => ({
  ...g,
  dibujo: g.imagen ? dibujos[`../assets/${g.imagen}.png`]?.default : undefined,
}));

// Los bloqueados no cuentan: la Liga se completa con los que estan abiertos.
const abiertos = gimnasios.filter((g) => !g.bloqueado).length;
---

<section class="vista gimnasios" data-vista="gimnasios" hidden>
  <div class="marco-exterior"></div>
  <div class="marco-interior"></div>

  <div class="barra">
    <a class="volver" href="#" data-ir-a="invitacion">← Volver</a>
    <span class="firma">LUCÍA &amp; MANUEL</span>
  </div>

  <div class="titulo">
    <h2>Los gimnasios</h2>
    <p class="subtitulo">Retos del día</p>
  </div>

  <p class="normas">
    Cada gimnasio es un reto para la boda. Cuando lo consigas, toca la medalla para marcarlo. Si te
    has equivocado, tócala otra vez para deshacerlo.
  </p>

  <div class="progreso">
    <div class="cabecera-progreso">
      <span class="epigrafe">MEDALLAS</span>
      <span class="cuenta" data-contador>0 / {abiertos}</span>
    </div>
    <div class="barra-progreso"><div data-barra></div></div>
  </div>

  <div class="retos">
    {
      gimnasios.map((g) => (
        <div class="reto" data-gimnasio={g.id} data-bloqueado={g.bloqueado ? '' : undefined}>
          <div class="cabecera">
            <button
              class="medalla"
              type="button"
              aria-pressed="false"
              aria-label={`Marcar la medalla de ${g.reto}`}
              disabled={g.bloqueado}
            >
              {g.bloqueado ? <span class="candado" /> : <span class="gema" />}
            </button>

            <button class="resumen" type="button" aria-expanded="false" aria-controls={`gym-${g.id}`}>
              <span class="texto">
                <span class="numero">{g.gimnasio}</span>
                <span class="tarea">{g.reto}</span>
              </span>
              <span class="marca">{g.bloqueado ? 'PRÓXIMAMENTE' : 'HECHO'}</span>
              <span class="chevron" />
            </button>
          </div>

          <div class="detalle" id={`gym-${g.id}`} hidden>
            {g.dibujo && (
              <div class="dibujo">
                <Image src={g.dibujo} alt="" width={300} loading="lazy" />
              </div>
            )}
            <p class="descripcion">{g.descripcion}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="campeon" data-campeon hidden>
    <div class="marco-campeon"></div>
    <p class="epigrafe">LIGA COMPLETADA</p>
    <h3>¡Campeón de la Liga!</h3>
    <p class="texto-campeon">Has conseguido todas las medallas. Enséñaselo a los novios.</p>
  </div>

  <p class="aviso">
    Las medallas se guardan solo en este móvil. Si borras los datos del navegador, se pierden.
  </p>

  <div class="pie-vista">
    <a class="boton-solido" href="#" data-ir-a="invitacion">Volver a la invitación</a>
  </div>
</section>

<noscript>
  <!--
    Sin JavaScript no hay desplegable ni medallas que marcar, pero el texto del
    lider de cada gimnasio se lee igual: es lo que explica el reto.
  -->
  <style>
    .gimnasios .detalle[hidden] {
      display: flex !important;
    }

    .gimnasios .chevron {
      display: none;
    }
  </style>
</noscript>

<style>
  .gimnasios {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100vh;
    padding: 22px 18px 40px;
  }

  .marco-exterior,
  .marco-interior {
    position: absolute;
    pointer-events: none;
  }

  .marco-exterior {
    inset: 10px;
    border: 1.5px solid var(--dorado);
  }

  .marco-interior {
    inset: 15px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
  }

  .barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px 0;
  }

  .volver {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .firma {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado);
  }

  .titulo {
    position: relative;
    text-align: center;
  }

  .titulo h2 {
    margin: 0;
    font-family: var(--script);
    font-size: 40px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .subtitulo {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--texto-suave);
  }

  .normas {
    position: relative;
    margin: 0 10px;
    padding: 16px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    text-wrap: pretty;
  }

  .progreso {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .cabecera-progreso {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .epigrafe {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--dorado-oscuro);
  }

  .cuenta {
    font-size: 22px;
    font-weight: 600;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .barra-progreso {
    height: 8px;
    border: 0.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.6);
  }

  .barra-progreso div {
    width: 0;
    height: 100%;
    background: var(--dorado-oscuro);
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .retos {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 10px;
  }

  .reto {
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    transition: background 0.3s;
  }

  .reto[data-hecho] {
    background: rgba(138, 100, 35, 0.1);
  }

  /* Un reto sin anunciar sigue a la vista, pero se lee como apagado. */
  .reto[data-bloqueado] {
    opacity: 0.6;
  }

  .cabecera {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px 14px;
  }

  .medalla {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--dorado);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition:
      background 0.3s,
      transform 0.3s;
  }

  .reto[data-bloqueado] .medalla {
    border-style: dashed;
    cursor: default;
  }

  .reto[data-hecho] .medalla {
    background: var(--dorado-oscuro);
    transform: scale(1.08);
  }

  .gema {
    width: 7px;
    height: 7px;
    background: var(--dorado);
    transform: rotate(45deg);
    transition: background 0.3s;
  }

  .reto[data-hecho] .gema {
    background: var(--sobre-dorado);
  }

  /* Candado dibujado con dos cajas: arco arriba, cuerpo abajo. */
  .candado {
    position: relative;
    width: 12px;
    height: 14px;
  }

  .candado::before,
  .candado::after {
    content: '';
    position: absolute;
  }

  .candado::before {
    top: 0;
    left: 2px;
    width: 6px;
    height: 7px;
    border: 1.5px solid var(--dorado);
    border-bottom: none;
    border-radius: 5px 5px 0 0;
  }

  .candado::after {
    top: 6px;
    left: 0;
    width: 12px;
    height: 8px;
    background: var(--dorado);
  }

  .resumen {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--texto);
    text-align: left;
    cursor: pointer;
  }

  .texto {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .numero {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado-oscuro);
  }

  .tarea {
    font-size: 17px;
    line-height: 1.3;
  }

  .reto[data-hecho] .tarea {
    color: var(--dorado-oscuro);
    text-decoration: line-through;
  }

  .marca {
    flex: none;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado-oscuro);
  }

  /* "HECHO" solo cuando lo esta; "PRÓXIMAMENTE" siempre, que no depende de nadie. */
  .reto:not([data-hecho]):not([data-bloqueado]) .marca {
    visibility: hidden;
  }

  .reto[data-hecho] .marca {
    animation: aparecer 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .chevron {
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 4px;
    border-right: 1px solid var(--dorado);
    border-bottom: 1px solid var(--dorado);
    transform: rotate(45deg);
    transition: transform 0.3s;
  }

  .resumen[aria-expanded='true'] .chevron {
    transform: rotate(225deg);
  }

  .detalle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 14px 16px;
    animation: aparecer 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .dibujo {
    display: flex;
    justify-content: center;
  }

  .dibujo :global(img) {
    display: block;
    width: 150px;
    height: 150px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .descripcion {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .campeon {
    position: relative;
    margin: 0 10px;
    padding: 26px 20px 24px;
    border: 1.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    text-align: center;
    animation: aparecer 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .marco-campeon {
    position: absolute;
    inset: 4px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
    pointer-events: none;
  }

  .campeon h3 {
    position: relative;
    margin: 10px 0 0;
    font-family: var(--script);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .campeon .epigrafe,
  .texto-campeon {
    position: relative;
  }

  .texto-campeon {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campeon,
    .detalle,
    .reto[data-hecho] .marca {
      animation: none;
    }

    .barra-progreso div,
    .medalla,
    .gema,
    .chevron,
    .reto {
      transition: none;
    }
  }

  .aviso {
    position: relative;
    margin: 0;
    padding: 0 10px;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
    color: var(--texto-suave);
  }

  .pie-vista {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 6px;
  }

  .boton-solido {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 28px;
    border: 1px solid var(--dorado-oscuro);
    background: var(--dorado-oscuro);
    color: var(--sobre-dorado);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boton-solido:hover {
    color: var(--sobre-dorado);
  }
</style>

<script>
  import { CLAVE_MEDALLAS, leerMedallas, guardarMedallas } from '../lib/medallas';

  const seccion = document.querySelector<HTMLElement>('.gimnasios');

  if (seccion) {
    const retos = [...seccion.querySelectorAll<HTMLElement>('[data-gimnasio]')];
    const contador = seccion.querySelector<HTMLElement>('[data-contador]');
    const barra = seccion.querySelector<HTMLElement>('[data-barra]');
    const campeon = seccion.querySelector<HTMLElement>('[data-campeon]');

    // Los bloqueados no entran en la cuenta: la Liga se gana con los abiertos.
    const abiertos = retos.filter((r) => r.dataset.bloqueado === undefined);

    let conseguidas = leerMedallas();

    // Los retos cambiaron de nombre al rediseno: lo que quedara guardado con
    // los identificadores viejos ya no corresponde a ningun gimnasio, asi que
    // se tira en vez de arrastrarlo para siempre.
    const vigentes = new Set(retos.map((r) => r.dataset.gimnasio!));
    const caducadas = Object.keys(conseguidas).filter((id) => !vigentes.has(id));
    if (caducadas.length > 0) {
      caducadas.forEach((id) => delete conseguidas[id]);
      guardarMedallas(conseguidas);
    }

    const pintar = () => {
      const hechas = abiertos.filter((r) => conseguidas[r.dataset.gimnasio!]).length;

      abiertos.forEach((reto) => {
        const hecha = !!conseguidas[reto.dataset.gimnasio!];
        // El atributo manda el estilo de toda la tarjeta, no solo el del boton.
        if (hecha) reto.dataset.hecho = '';
        else delete reto.dataset.hecho;
        reto.querySelector('.medalla')?.setAttribute('aria-pressed', String(hecha));
      });

      if (contador) contador.textContent = `${hechas} / ${abiertos.length}`;
      if (barra) barra.style.width = `${(hechas / abiertos.length) * 100}%`;
      if (campeon) campeon.hidden = hechas !== abiertos.length;

      // El bloque LOS GIMNASIOS de la invitacion pinta el mismo numero. Se
      // avisa desde aqui, que es quien sabe cuando cambia y ya ha limpiado lo
      // que quedara guardado de la version anterior de los retos.
      window.dispatchEvent(new CustomEvent('lm:avance'));
    };

    retos.forEach((reto) => {
      const medalla = reto.querySelector<HTMLButtonElement>('.medalla');
      const resumen = reto.querySelector<HTMLButtonElement>('.resumen');
      const detalle = reto.querySelector<HTMLElement>('.detalle');

      medalla?.addEventListener('click', () => {
        const id = reto.dataset.gimnasio!;
        if (conseguidas[id]) delete conseguidas[id];
        else conseguidas[id] = true;
        guardarMedallas(conseguidas);
        pintar();
      });

      // Solo un desplegable abierto a la vez, como en el diseno: la lista es
      // larga y con dos abiertos hay que hacer scroll a ciegas.
      resumen?.addEventListener('click', () => {
        const abierto = resumen.getAttribute('aria-expanded') === 'true';

        retos.forEach((otro) => {
          otro.querySelector('.resumen')?.setAttribute('aria-expanded', 'false');
          const suyo = otro.querySelector<HTMLElement>('.detalle');
          if (suyo) suyo.hidden = true;
        });

        if (!abierto) {
          resumen.setAttribute('aria-expanded', 'true');
          if (detalle) detalle.hidden = false;
        }
      });
    });

    // Otra pestana con la misma web abierta no debe quedarse con las medallas
    // viejas: el evento solo llega a las pestanas que no hicieron el cambio.
    window.addEventListener('storage', (evento) => {
      if (evento.key !== CLAVE_MEDALLAS) return;
      conseguidas = leerMedallas();
      pintar();
    });

    pintar();
  }
</script>
