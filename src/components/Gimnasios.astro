---
import { GIMNASIOS } from '../data/pokedex';
---

<section class="vista gimnasios" data-vista="gimnasios" hidden>
  <div class="marco-exterior"></div>
  <div class="marco-interior"></div>

  <div class="barra">
    <a class="volver" href="#" data-ir-a="invitacion">← Volver</a>
    <span class="firma">LUCÍA &amp; MANUEL</span>
  </div>

  <div class="titulo">
    <h2>Los gimnasios</h2>
    <p class="subtitulo">Retos del día</p>
  </div>

  <p class="normas">
    Cada gimnasio es un reto para la boda. Cuando lo consigas, toca la medalla para marcarlo. Si te
    has equivocado, tócala otra vez para deshacerlo.
  </p>

  <div class="progreso">
    <div class="cabecera-progreso">
      <span class="epigrafe">MEDALLAS</span>
      <span data-contador>0 / {GIMNASIOS.length}</span>
    </div>
    <div class="barra-progreso"><div data-barra></div></div>
  </div>

  <div class="retos">
    {
      GIMNASIOS.map((g) => (
        <button class="reto" type="button" data-gimnasio={g.id} aria-pressed="false">
          <span class="medalla"></span>
          <span class="texto">
            <span class="numero">{g.gimnasio}</span>
            <span class="tarea">{g.reto}</span>
          </span>
          <span class="hecho">HECHO</span>
        </button>
      ))
    }
  </div>

  <div class="campeon" data-campeon hidden>
    <div class="marco-campeon"></div>
    <p class="epigrafe">LIGA COMPLETADA</p>
    <h3>¡Campeón de la Liga!</h3>
    <p class="texto-campeon">Has conseguido todas las medallas. Enséñaselo a los novios.</p>
  </div>

  <p class="aviso">
    Las medallas se guardan solo en este móvil. Si borras los datos del navegador, se pierden.
  </p>

  <div class="pie-vista">
    <a class="boton-solido" href="#" data-ir-a="invitacion">Volver a la invitación</a>
  </div>
</section>

<style>
  .gimnasios {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100vh;
    padding: 22px 18px 40px;
  }

  .marco-exterior,
  .marco-interior {
    position: absolute;
    pointer-events: none;
  }

  .marco-exterior {
    inset: 10px;
    border: 1.5px solid var(--dorado);
  }

  .marco-interior {
    inset: 15px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
  }

  .barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px 0;
  }

  .volver {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .firma {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado);
  }

  .titulo {
    position: relative;
    text-align: center;
  }

  .titulo h2 {
    margin: 0;
    font-family: var(--script);
    font-size: 40px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .subtitulo {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--texto-suave);
  }

  .normas {
    position: relative;
    margin: 0;
    padding: 0 10px;
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .progreso {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .cabecera-progreso {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 15px;
    color: var(--dorado-oscuro);
  }

  .epigrafe {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--dorado-oscuro);
  }

  .barra-progreso {
    height: 4px;
    border: 0.5px solid var(--dorado);
    background: transparent;
  }

  .barra-progreso div {
    width: 0;
    height: 100%;
    background: var(--dorado-oscuro);
    transition: width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .retos {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .reto {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 62px;
    padding: 10px 12px;
    border: 1px solid var(--dorado);
    background: transparent;
    color: var(--texto);
    text-align: left;
    cursor: pointer;
  }

  .medalla {
    flex: none;
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--dorado);
    border-radius: 50%;
    transition: background 0.25s;
  }

  .reto[aria-pressed='true'] {
    background: rgba(163, 121, 42, 0.1);
  }

  .reto[aria-pressed='true'] .medalla {
    background: var(--dorado-oscuro);
    box-shadow: inset 0 0 0 3px var(--pergamino-claro);
  }

  .texto {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
  }

  .numero {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--dorado);
  }

  .tarea {
    font-size: 16px;
    line-height: 1.3;
  }

  .hecho {
    flex: none;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--dorado-oscuro);
  }

  .reto[aria-pressed='false'] .hecho {
    visibility: hidden;
  }

  .campeon {
    position: relative;
    margin: 0 10px;
    padding: 26px 20px 24px;
    border: 1.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    text-align: center;
    animation: aparecer 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .marco-campeon {
    position: absolute;
    inset: 4px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
    pointer-events: none;
  }

  .campeon h3 {
    position: relative;
    margin: 10px 0 0;
    font-family: var(--script);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .campeon .epigrafe,
  .texto-campeon {
    position: relative;
  }

  .texto-campeon {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campeon {
      animation: none;
    }
    .barra-progreso div {
      transition: none;
    }
  }

  .aviso {
    position: relative;
    margin: 0;
    padding: 0 10px;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
    color: var(--texto-suave);
  }

  .pie-vista {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 6px;
  }

  .boton-solido {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 28px;
    border: 1px solid var(--dorado-oscuro);
    background: var(--dorado-oscuro);
    color: var(--sobre-dorado);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boton-solido:hover {
    color: var(--sobre-dorado);
  }
</style>

<script>
  // Las medallas viven solo aqui: sin login y sin servidor, como se decidio.
  // Si el invitado borra los datos del navegador, las pierde.
  const CLAVE = 'lm-gimnasios';

  const seccion = document.querySelector<HTMLElement>('.gimnasios');

  if (seccion) {
    const botones = [...seccion.querySelectorAll<HTMLButtonElement>('[data-gimnasio]')];
    const contador = seccion.querySelector<HTMLElement>('[data-contador]');
    const barra = seccion.querySelector<HTMLElement>('[data-barra]');
    const campeon = seccion.querySelector<HTMLElement>('[data-campeon]');

    const leer = (): Record<string, boolean> => {
      try {
        return JSON.parse(localStorage.getItem(CLAVE) || '{}');
      } catch {
        return {};
      }
    };

    let conseguidas = leer();

    const guardar = () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(conseguidas));
      } catch {
        // Incognito o almacenamiento lleno: se sigue jugando sin recordar.
      }
    };

    const pintar = () => {
      const total = botones.length;
      const hechas = botones.filter((b) => conseguidas[b.dataset.gimnasio!]).length;

      botones.forEach((boton) => {
        boton.setAttribute('aria-pressed', String(!!conseguidas[boton.dataset.gimnasio!]));
      });

      if (contador) contador.textContent = `${hechas} / ${total}`;
      if (barra) barra.style.width = `${(hechas / total) * 100}%`;
      if (campeon) campeon.hidden = hechas !== total;
    };

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const id = boton.dataset.gimnasio!;
        if (conseguidas[id]) delete conseguidas[id];
        else conseguidas[id] = true;
        guardar();
        pintar();
      });
    });

    pintar();
  }
</script>
