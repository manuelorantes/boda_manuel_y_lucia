---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { GIMNASIOS } from '../data/pokedex';

// Las ilustraciones se importan por glob y no una a una: asi un gimnasio cuya
// imagen todavia no este en src/assets se queda sin dibujo en vez de romper el
// build, igual que hace el comic de "Nuestra historia".
const dibujos = import.meta.glob<{ default: ImageMetadata }>('../assets/*.png', { eager: true });

const gimnasios = GIMNASIOS.map((g) => ({
  ...g,
  dibujo: g.imagen ? dibujos[`../assets/${g.imagen}.png`]?.default : undefined,
  // Misma regla que las ilustraciones: una medalla cuyo PNG todavia no este en
  // src/assets deja su hueco con el nombre, en vez de tumbar el build.
  chapa: dibujos[`../assets/${g.medalla.imagen}.png`]?.default,
}));

// Los carteles de "se busca" se pintan una sola vez, fuera de las tarjetas, y
// el script ensena el que toque. La lista sale de los propios retos para que
// anadir buscados a otro gimnasio no obligue a tocar esto.
const buscados = GIMNASIOS.flatMap((g) => g.buscados ?? []).map((b) => ({
  ...b,
  dibujo: b.imagen ? dibujos[`../assets/${b.imagen}.png`]?.default : undefined,
}));

// La Liga son ocho medallas, y el total no se mueve: da igual cuantos retos
// haya abiertos en ese momento. Un total que subiera y bajara cada vez que los
// novios abren un reto haria parecer que el avance se pierde.
const MEDALLAS_DE_LA_LIGA = gimnasios.length;
---

<section class="vista gimnasios" data-vista="gimnasios" hidden>
  <div class="marco-exterior"></div>
  <div class="marco-interior"></div>

  <div class="barra">
    <a class="volver" href="#" data-ir-a="invitacion">← Volver</a>
    <span class="firma">LUCÍA &amp; MANUEL</span>
  </div>

  <div class="titulo">
    <h2>Los gimnasios</h2>
    <p class="subtitulo">Retos del día</p>
  </div>

  <p class="normas">
    Cada gimnasio es un reto para la boda. Cuando lo consigas, toca la medalla para marcarlo. Si te
    has equivocado, tócala otra vez para deshacerlo.
  </p>

  <div class="progreso">
    <div class="cabecera-progreso">
      <span class="epigrafe">MEDALLAS</span>
      <span class="cuenta" data-contador>0 / {MEDALLAS_DE_LA_LIGA}</span>
    </div>
    <div class="barra-progreso"><div data-barra></div></div>
  </div>

  <div class="medallero">
    {
      gimnasios.map((g) => (
        <div class="casilla" data-medallero={g.id}>
          <div class="chapa">
            {/* Sin `width`: miden 97 px y pedir mas solo las estiraria. */}
            {g.chapa && <Image src={g.chapa} alt="" loading="lazy" />}
          </div>
          <span class="nombre-medalla">{g.medalla.nombre}</span>
        </div>
      ))
    }
  </div>

  <div class="retos">
    {
      gimnasios.map((g) => (
        /*
          `data-bloqueado` sale ya puesto en los que nacen cerrados: asi la
          tarjeta correcta se ve desde el primer pintado, antes de que conteste
          el servidor, y tambien sin JavaScript. Luego el script lo pone y lo
          quita segun lo que diga el Apps Script.
        */
        <div class="reto" data-gimnasio={g.id} data-bloqueado={g.bloqueadoPorDefecto ? '' : undefined}>
          <div class="cabecera">
            <button
              class="medalla"
              type="button"
              aria-pressed="false"
              aria-label={`Marcar la medalla del ${g.gimnasio.toLowerCase()}`}
              disabled={g.bloqueadoPorDefecto}
            >
              <span class="gema" />
              <span class="candado" />
            </button>

            <button class="resumen" type="button" aria-expanded="false" aria-controls={`gym-${g.id}`}>
              <span class="texto">
                <span class="numero">{g.gimnasio}</span>
                <span class="tarea">{g.reto}</span>
              </span>
              <span class="marca hecho">HECHO</span>
              <span class="marca bloqueado">BLOQUEADO</span>
              <span class="chevron" />
            </button>
          </div>

          <div class="detalle" id={`gym-${g.id}`} hidden>
            {g.dibujo && (
              <div class="dibujo">
                <Image src={g.dibujo} alt="" width={300} loading="lazy" />
              </div>
            )}
            <div class="texto-reto">
              <p class="descripcion" aria-hidden={g.bloqueadoPorDefecto ? 'true' : undefined}>
                {g.descripcion}
              </p>
              <div class="cartel">
                <div class="cartel-caja">
                  <p class="epigrafe">RETO BLOQUEADO</p>
                  <p class="pronto">Se desbloqueará próximamente.</p>
                </div>
              </div>
            </div>

            {g.buscados && (
              <div class="capturas">
                {g.buscados.map((b) => (
                  <button
                    class="captura"
                    type="button"
                    data-buscado={b.id}
                    aria-haspopup="dialog"
                    aria-label={`Ver el cartel de ${b.nombre}`}
                  >
                    <span class="nombre-captura">{b.nombre}</span>
                    <span class="sello" aria-hidden="true">
                      <span class="sello-caja">¡Atrapado!</span>
                    </span>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="campeon" data-campeon hidden>
    <div class="marco-campeon"></div>
    <p class="epigrafe">LIGA COMPLETADA</p>
    <h3>¡Campeón de la Liga!</h3>
    <p class="texto-campeon">Has conseguido todas las medallas. Enséñaselo a los novios.</p>
  </div>

  <p class="aviso">
    Las medallas se guardan solo en este móvil. Si borras los datos del navegador, se pierden.
  </p>

  <div class="pie-vista">
    <a class="boton-solido" href="#" data-ir-a="invitacion">Volver a la invitación</a>
  </div>
</section>

<div class="capa" data-buscados hidden>
  {
    buscados.map((b) => (
      <div
        class="tarjeta"
        role="dialog"
        aria-modal="true"
        aria-label={`Cartel de ${b.nombre}`}
        data-cartel={b.id}
        hidden
      >
        <div class="marco-tarjeta" />
        <p class="epigrafe se-busca" data-epigrafe>SE BUSCA</p>
        <div class="retrato">
          {/*
            Sin `width`: los carteles miden poco mas de 200 px de ancho y
            pedirle 300 a Astro solo los estiraria, pesando mas sin dar detalle.
            Con su tamano propio, el CSS los baja a los 180 px de la ficha.
          */}
          {b.dibujo && <Image src={b.dibujo} alt={`Cartel de ${b.nombre}`} loading="lazy" />}
          <span class="sello grande" aria-hidden="true">
            <span class="sello-caja">¡Atrapado!</span>
          </span>
        </div>
        <p class="nombre-buscado">{b.nombre}</p>
        <button class="cerrar" type="button" data-cerrar-cartel>
          Cerrar
        </button>
      </div>
    ))
  }
</div>

<noscript>
  <!--
    Sin JavaScript no hay desplegable ni medallas que marcar, pero el texto del
    lider de cada gimnasio se lee igual: es lo que explica el reto. Los
    cuadrados de los buscados si se van: sin script no abren su cartel, y un
    boton que no responde estorba mas que ayuda.
  -->
  <style>
    .gimnasios .detalle[hidden] {
      display: flex !important;
    }

    .gimnasios .chevron,
    .gimnasios .capturas {
      display: none;
    }
  </style>
</noscript>

<style>
  .gimnasios {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100vh;
    padding: 22px 18px 40px;
  }

  .marco-exterior,
  .marco-interior {
    position: absolute;
    pointer-events: none;
  }

  .marco-exterior {
    inset: 10px;
    border: 1.5px solid var(--dorado);
  }

  .marco-interior {
    inset: 15px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
  }

  .barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px 0;
  }

  .volver {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .firma {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado);
  }

  .titulo {
    position: relative;
    text-align: center;
  }

  .titulo h2 {
    margin: 0;
    font-family: var(--script);
    font-size: 40px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .subtitulo {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--texto-suave);
  }

  .normas {
    position: relative;
    margin: 0 10px;
    padding: 16px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    text-wrap: pretty;
  }

  .progreso {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .cabecera-progreso {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .epigrafe {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--dorado-oscuro);
  }

  .cuenta {
    font-size: 22px;
    font-weight: 600;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .barra-progreso {
    height: 8px;
    border: 0.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.6);
  }

  .barra-progreso div {
    width: 0;
    height: 100%;
    background: var(--dorado-oscuro);
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /*
    El medallero: las ocho de la Liga siempre a la vista, apagadas hasta que se
    consiguen. Es el marcador de un vistazo, y por eso estan las ocho aunque el
    reto que da la medalla siga bloqueado.
  */
  .medallero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px 6px;
    margin: 0 10px;
    padding: 14px 10px 12px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
  }

  .casilla {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .chapa {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
  }

  .chapa :global(img) {
    display: block;
    width: 56px;
    height: 56px;
    object-fit: contain;
    /* Sin conseguir: apagada y encogida. Al ganarla, recupera color y crece. */
    filter: grayscale(1) brightness(0.55);
    opacity: 0.35;
    transition:
      filter 0.5s,
      opacity 0.5s,
      transform 0.5s;
  }

  .casilla[data-hecho] .chapa :global(img) {
    filter: brightness(0.88) saturate(0.85);
    opacity: 0.92;
    transform: scale(1.06);
  }

  .nombre-medalla {
    font-size: 10px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    color: rgba(138, 100, 35, 0.45);
    transition: color 0.5s;
  }

  .casilla[data-hecho] .nombre-medalla {
    color: var(--dorado-oscuro);
  }

  .retos {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 10px;
  }

  .reto {
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    transition: background 0.3s;
  }

  .reto[data-hecho] {
    background: rgba(138, 100, 35, 0.1);
  }

  /* Un reto bloqueado sigue a la vista, pero se lee como apagado. */
  .reto[data-bloqueado] {
    opacity: 0.75;
  }

  .cabecera {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px 14px;
  }

  .medalla {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--dorado);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition:
      background 0.3s,
      transform 0.3s;
  }

  .reto[data-bloqueado] .medalla {
    border-style: dashed;
    cursor: default;
  }

  .reto[data-hecho] .medalla {
    background: var(--dorado-oscuro);
    transform: scale(1.08);
  }

  /*
    Los dos iconos de la medalla van siempre en el HTML y manda el CSS cual se
    ve. El bloqueo cambia en caliente cuando contesta el servidor, y asi el
    cambio es un atributo en la tarjeta y no reconstruir el boton.
  */
  .gema {
    width: 7px;
    height: 7px;
    background: var(--dorado);
    transform: rotate(45deg);
    transition: background 0.3s;
  }

  .reto[data-bloqueado] .gema,
  .reto:not([data-bloqueado]) .candado {
    display: none;
  }

  .reto[data-hecho] .gema {
    background: var(--sobre-dorado);
  }

  /* Candado dibujado con dos cajas: arco arriba, cuerpo abajo. */
  .candado {
    position: relative;
    width: 12px;
    height: 14px;
  }

  .candado::before,
  .candado::after {
    content: '';
    position: absolute;
  }

  .candado::before {
    top: 0;
    left: 2px;
    width: 6px;
    height: 7px;
    border: 1.5px solid var(--dorado);
    border-bottom: none;
    border-radius: 5px 5px 0 0;
  }

  .candado::after {
    top: 6px;
    left: 0;
    width: 12px;
    height: 8px;
    background: var(--dorado);
  }

  .resumen {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--texto);
    text-align: left;
    cursor: pointer;
  }

  .texto {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .numero {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado-oscuro);
  }

  .tarea {
    font-size: 17px;
    line-height: 1.3;
  }

  .reto[data-hecho] .tarea {
    color: var(--dorado-oscuro);
    text-decoration: line-through;
  }

  .marca {
    flex: none;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--dorado-oscuro);
  }

  /* "HECHO" solo cuando lo esta; "BLOQUEADO" manda sobre el otro. */
  .reto[data-bloqueado] .marca.hecho,
  .reto:not([data-bloqueado]) .marca.bloqueado,
  .reto:not([data-hecho]) .marca.hecho {
    display: none;
  }

  .reto[data-hecho]:not([data-bloqueado]) .marca.hecho {
    animation: aparecer 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .chevron {
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 4px;
    border-right: 1px solid var(--dorado);
    border-bottom: 1px solid var(--dorado);
    transform: rotate(45deg);
    transition: transform 0.3s;
  }

  .resumen[aria-expanded='true'] .chevron {
    transform: rotate(225deg);
  }

  .detalle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 14px 16px;
    animation: aparecer 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .dibujo {
    display: flex;
    justify-content: center;
  }

  .dibujo :global(img) {
    display: block;
    width: 150px;
    height: 150px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .descripcion {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--texto-suave);
    text-wrap: pretty;
    transition: filter 0.4s;
  }

  /*
    Bloqueado: el titulo y el Pokemon se ven siempre, y el texto queda
    desenfocado con el cartel encima, como en el diseno.
    
    El desenfoque es un recurso visual, no una proteccion: el texto sigue en el
    HTML y en el repositorio, que es publico. Se asumio a cambio de que la
    pantalla se lea entera aunque el movil se quede sin cobertura.
  */
  .texto-reto {
    position: relative;
  }

  .reto[data-bloqueado] .descripcion {
    filter: blur(5px);
    user-select: none;
  }

  .cartel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .reto:not([data-bloqueado]) .cartel {
    display: none;
  }

  .cartel-caja {
    padding: 12px 16px;
    border: 1px solid var(--dorado);
    background: rgba(247, 240, 222, 0.92);
    text-align: center;
  }

  .cartel-caja p {
    margin: 0;
  }

  .pronto {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.4;
  }

  /* --- Los ocho buscados y su cartel --- */

  /* Cuatro y cuatro: los ocho caben en dos filas y el cuadrado sale cuadrado. */
  .capturas {
    display: grid;
    /*
      minmax(0, 1fr) y no 1fr a secas: `1fr` es minmax(auto, 1fr), y ese `auto`
      impide que la columna baje del ancho minimo de su nombre. Si el movil
      agranda el tipo por su cuenta (tamano minimo de letra del navegador,
      ajuste de accesibilidad), VAPOREON deja de caber en un cuarto del ancho,
      las columnas crecen, la rejilla se sale del cuadro y `main` se la come
      por la derecha con su overflow: hidden. El resultado es justo lo que se
      ve: la ultima columna pegada al borde y la primera con su margen intacto.
      Con el minimo en 0 las columnas siempre miden lo mismo y la rejilla no
      puede descentrarse.
    */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  /*
    Con el reto bloqueado los cuadrados desaparecen en vez de quedarse debajo
    del cartel: no hay nada que buscar todavia, y ademas el cartel de
    "RETO BLOQUEADO" solo tapa el texto.
  */
  .reto[data-bloqueado] .capturas {
    display: none;
  }

  .captura {
    /* El sello se estira sobre este cuadrado, asi que tiene que anclar aqui. */
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Lo mismo que en las columnas, pero para la casilla: sin esto el cuadrado
       tampoco baja del ancho de su nombre y vuelve a desbordar. */
    min-width: 0;
    aspect-ratio: 1;
    padding: 4px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.75);
    color: var(--dorado-oscuro);
    /*
      El nombre mas largo es VAPOREON y tiene que caber en una linea dentro del
      cuadrado, que mide la cuarta parte del ancho. En un movil estrecho el
      tipo baja con la pantalla en vez de partir la palabra.
    */
    font-size: clamp(8px, 2.6vw, 11px);
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
  }

  .captura:hover {
    background: rgba(138, 100, 35, 0.12);
  }

  /*
    Atrapado: el cuadrado se apaga y el nombre pierde fuerza, para que los que
    quedan sueltos sean los que llaman la atencion. Lo pone el servidor, no el
    movil: la caza es de todos, no de cada uno.
  */
  .captura[data-atrapado] {
    background: rgba(163, 121, 42, 0.08);
    color: rgba(138, 100, 35, 0.45);
  }

  .nombre-captura {
    position: relative;
  }

  /*
    El sello son dos piezas: la de fuera se estira sobre el cuadrado o sobre la
    foto y centra, y la de dentro es la que lleva el marco y el giro. Con una
    sola, girar descolocaria el centrado.
  */
  .sello {
    display: none;
  }

  [data-atrapado] .sello {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .sello-caja {
    padding: 2px 6px;
    border: 1.5px solid var(--rojo-sello);
    background: rgba(247, 240, 222, 0.85);
    color: var(--rojo-sello);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: rotate(-24deg);
  }

  /* El de la ficha es el mismo sello, en grande y mas torcido. */
  .sello.grande .sello-caja {
    padding: 4px 14px;
    border-width: 3px;
    background: rgba(247, 240, 222, 0.6);
    font-size: 28px;
    letter-spacing: 0.08em;
    transform: rotate(-32deg);
  }

  [data-atrapado] .sello.grande {
    animation: aparecer 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* Mismo modal que la estrofa de "Nuestra historia". */
  .capa {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(74, 52, 22, 0.45);
  }

  .tarjeta {
    position: relative;
    width: 100%;
    max-width: 360px;
    padding: 28px 24px 24px;
    border: 1.5px solid var(--dorado);
    background: rgba(247, 240, 222, 0.9);
    box-shadow: 0 20px 60px rgba(40, 25, 5, 0.35);
    text-align: center;
  }

  .marco-tarjeta {
    position: absolute;
    inset: 4px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
    pointer-events: none;
  }

  .se-busca {
    position: relative;
    margin: 0;
  }

  .retrato {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 14px;
  }

  .retrato :global(img) {
    display: block;
    width: 180px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: filter 0.5s;
  }

  /* Ya cazado: la foto se apaga y el sello cae encima. */
  .tarjeta[data-atrapado] .retrato :global(img) {
    filter: grayscale(1) contrast(0.9) opacity(0.8);
  }

  .tarjeta[data-atrapado] .nombre-buscado {
    color: var(--texto-suave);
  }

  .nombre-buscado {
    position: relative;
    margin: 14px 0 0;
    font-family: var(--script);
    font-size: 32px;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .cerrar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 20px auto 0;
    padding: 0 22px;
    border: 1px solid var(--dorado);
    background: transparent;
    color: var(--dorado-oscuro);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .campeon {
    position: relative;
    margin: 0 10px;
    padding: 26px 20px 24px;
    border: 1.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
    text-align: center;
    animation: aparecer 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .marco-campeon {
    position: absolute;
    inset: 4px;
    border: 0.5px solid rgba(163, 121, 42, 0.55);
    pointer-events: none;
  }

  .campeon h3 {
    position: relative;
    margin: 10px 0 0;
    font-family: var(--script);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
    color: var(--dorado-oscuro);
  }

  .campeon .epigrafe,
  .texto-campeon {
    position: relative;
  }

  .texto-campeon {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campeon,
    .detalle,
    [data-atrapado] .sello.grande,
    .reto[data-hecho] .marca {
      animation: none;
    }

    .retrato :global(img),
    .barra-progreso div,
    .medalla,
    .gema,
    .chevron,
    .descripcion,
    .captura,
    .reto {
      transition: none;
    }
  }

  .aviso {
    position: relative;
    margin: 0;
    padding: 0 10px;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
    color: var(--texto-suave);
  }

  .pie-vista {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 6px;
  }

  .boton-solido {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 28px;
    border: 1px solid var(--dorado-oscuro);
    background: var(--dorado-oscuro);
    color: var(--sobre-dorado);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boton-solido:hover {
    color: var(--sobre-dorado);
  }
</style>

<script>
  import { CLAVE_MEDALLAS, leerMedallas, guardarMedallas } from '../lib/medallas';
  import {
    cargarRetos,
    retosGuardados,
    buscadosGuardados,
    type EstadoReto,
    type EstadoBuscado,
  } from '../lib/retos';

  const seccion = document.querySelector<HTMLElement>('.gimnasios');

  if (seccion) {
    const retos = [...seccion.querySelectorAll<HTMLElement>('[data-gimnasio]')];
    const casillas = [...seccion.querySelectorAll<HTMLElement>('[data-medallero]')];
    const contador = seccion.querySelector<HTMLElement>('[data-contador]');
    const barra = seccion.querySelector<HTMLElement>('[data-barra]');
    const campeon = seccion.querySelector<HTMLElement>('[data-campeon]');

    let conseguidas = leerMedallas();

    // Los retos cambiaron de nombre al rediseno: lo que quedara guardado con
    // los identificadores viejos ya no corresponde a ningun gimnasio, asi que
    // se tira en vez de arrastrarlo para siempre.
    const vigentes = new Set(retos.map((r) => r.dataset.gimnasio!));
    const caducadas = Object.keys(conseguidas).filter((id) => !vigentes.has(id));
    if (caducadas.length > 0) {
      caducadas.forEach((id) => delete conseguidas[id]);
      guardarMedallas(conseguidas);
    }

    const abierto = (reto: HTMLElement) => reto.dataset.bloqueado === undefined;

    /**
     * Aplica el estado que manda el servidor: que retos estan abiertos y, si
     * la hoja trae texto propio, con que se pinta la tarjeta.
     */
    const aplicarRetos = (estados: EstadoReto[]) => {
      const porId = new Map(estados.map((e) => [e.id, e]));

      retos.forEach((reto) => {
        const estado = porId.get(reto.dataset.gimnasio!);
        // Un reto que el servidor no menciona se queda como esta: mejor no
        // tocarlo que abrirlo por un descuadre entre la hoja y la web.
        if (!estado) return;

        if (estado.bloqueado) reto.dataset.bloqueado = '';
        else delete reto.dataset.bloqueado;

        reto.querySelector<HTMLButtonElement>('.medalla')!.disabled = estado.bloqueado;

        // Un lector de pantalla no ve el desenfoque y leeria el reto entero,
        // asi que cuando esta bloqueado se le deja solo el cartel.
        const texto = reto.querySelector<HTMLElement>('.descripcion');
        if (texto) {
          if (estado.bloqueado) texto.setAttribute('aria-hidden', 'true');
          else texto.removeAttribute('aria-hidden');
        }

        if (estado.reto) {
          const tarea = reto.querySelector<HTMLElement>('.tarea');
          if (tarea) tarea.textContent = estado.reto;
        }
        if (estado.descripcion && texto) texto.textContent = estado.descripcion;
      });

      pintar();
    };

    /**
     * Marca en pantalla los que ya estan atrapados.
     *
     * Solo la cuenta maestra los cambia, desde el panel, asi que aqui es de
     * lectura: el invitado ve caer el sello cuando alguien los encuentra.
     */
    const aplicarBuscados = (estados: EstadoBuscado[]) => {
      const atrapados = new Set(estados.filter((e) => e.atrapado).map((e) => e.id));

      [...document.querySelectorAll<HTMLElement>('[data-buscado]')].forEach((cuadrado) => {
        const cazado = atrapados.has(cuadrado.dataset.buscado!);
        if (cazado) cuadrado.dataset.atrapado = '';
        else delete cuadrado.dataset.atrapado;

        // El sello es decorativo, asi que el estado tiene que ir tambien en el
        // texto: un lector de pantalla no ve que la ficha este tachada.
        const nombre = cuadrado.querySelector('.nombre-captura')?.textContent?.trim() ?? '';
        cuadrado.setAttribute(
          'aria-label',
          cazado ? `${nombre}, ya atrapado. Ver su cartel` : `Ver el cartel de ${nombre}`,
        );
      });

      document.querySelectorAll<HTMLElement>('[data-cartel]').forEach((cartel) => {
        const cazado = atrapados.has(cartel.dataset.cartel!);
        if (cazado) cartel.dataset.atrapado = '';
        else delete cartel.dataset.atrapado;

        const epigrafe = cartel.querySelector<HTMLElement>('[data-epigrafe]');
        if (epigrafe) epigrafe.textContent = cazado ? 'CAPTURADO' : 'SE BUSCA';
      });
    };

    const pintar = () => {
      // El total son los ocho, esten sus retos abiertos o no. Y una medalla ya
      // ganada sigue contando aunque los novios vuelvan a cerrar su reto: se
      // gano, y ver bajar el marcador seria de lo mas injusto.
      const total = retos.length;
      const hechas = retos.filter((r) => conseguidas[r.dataset.gimnasio!]).length;

      retos.forEach((reto) => {
        const hecha = !!conseguidas[reto.dataset.gimnasio!];
        // El atributo manda el estilo de toda la tarjeta, no solo el del boton.
        if (hecha) reto.dataset.hecho = '';
        else delete reto.dataset.hecho;
        reto.querySelector('.medalla')?.setAttribute('aria-pressed', String(hecha));
      });

      casillas.forEach((casilla) => {
        if (conseguidas[casilla.dataset.medallero!]) casilla.dataset.hecho = '';
        else delete casilla.dataset.hecho;
      });

      if (contador) contador.textContent = `${hechas} / ${total}`;
      if (barra) barra.style.width = `${total ? (hechas / total) * 100 : 0}%`;
      if (campeon) campeon.hidden = hechas !== total;

      // El bloque LOS GIMNASIOS de la invitacion pinta el mismo numero. Se
      // avisa desde aqui, que es quien sabe cuando cambia y ya ha limpiado lo
      // que quedara guardado de la version anterior de los retos.
      window.dispatchEvent(new CustomEvent('lm:avance'));
    };

    retos.forEach((reto) => {
      const medalla = reto.querySelector<HTMLButtonElement>('.medalla');
      const resumen = reto.querySelector<HTMLButtonElement>('.resumen');
      const detalle = reto.querySelector<HTMLElement>('.detalle');

      medalla?.addEventListener('click', () => {
        if (!abierto(reto)) return;
        const id = reto.dataset.gimnasio!;
        if (conseguidas[id]) delete conseguidas[id];
        else conseguidas[id] = true;
        guardarMedallas(conseguidas);
        pintar();
      });

      // Solo un desplegable abierto a la vez, como en el diseno: la lista es
      // larga y con dos abiertos hay que hacer scroll a ciegas.
      resumen?.addEventListener('click', () => {
        const desplegado = resumen.getAttribute('aria-expanded') === 'true';

        retos.forEach((otro) => {
          otro.querySelector('.resumen')?.setAttribute('aria-expanded', 'false');
          const suyo = otro.querySelector<HTMLElement>('.detalle');
          if (suyo) suyo.hidden = true;
        });

        if (!desplegado) {
          resumen.setAttribute('aria-expanded', 'true');
          if (detalle) detalle.hidden = false;
        }
      });
    });

    // Otra pestana con la misma web abierta no debe quedarse con las medallas
    // viejas: el evento solo llega a las pestanas que no hicieron el cambio.
    window.addEventListener('storage', (evento) => {
      if (evento.key !== CLAVE_MEDALLAS) return;
      conseguidas = leerMedallas();
      pintar();
    });

    // Primero lo ultimo que se supo, que pinta al instante; despues lo que
    // diga el servidor. Sin esto la pantalla se queda un segundo largo con el
    // estado de fabrica mientras responde el Apps Script.
    const guardados = retosGuardados();
    if (guardados) aplicarRetos(guardados);
    else pintar();

    const cazadosGuardados = buscadosGuardados();
    if (cazadosGuardados) aplicarBuscados(cazadosGuardados);

    cargarRetos()
      .then((respuesta) => {
        aplicarRetos(respuesta.retos);
        // Sin la pestana `Buscados` en la hoja la clave no viene. Se deja lo
        // que hubiera en pantalla en vez de soltarlos a todos de golpe.
        if (respuesta.buscados) aplicarBuscados(respuesta.buscados);
      })
      .catch(() => {
        // Sin cobertura se queda lo ultimo conocido. No se avisa: el invitado
        // no puede hacer nada al respecto y los retos se leen igual.
      });
  }

  // Los cuadrados de los buscados abren su cartel de "se busca". Mismo patron
  // que el modal de la estrofa: una sola capa con una tarjeta por Pokemon, y
  // se ensena la que se ha pedido. La capa vive fuera de la seccion porque se
  // superpone a la pantalla en vez de navegar.
  const capa = document.querySelector<HTMLElement>('[data-buscados]');

  if (capa) {
    const carteles = [...capa.querySelectorAll<HTMLElement>('[data-cartel]')];

    // Se recuerda quien abrio para devolverle el foco al cerrar: si no, salta
    // al principio de la pantalla y hay que buscar otra vez el cuadrado.
    let quienAbrio: HTMLElement | null = null;

    const cerrar = () => {
      capa.hidden = true;
      carteles.forEach((cartel) => (cartel.hidden = true));
      quienAbrio?.focus();
      quienAbrio = null;
    };

    const abrir = (boton: HTMLButtonElement) => {
      const cartel = carteles.find((c) => c.dataset.cartel === boton.dataset.buscado);
      if (!cartel) return;

      carteles.forEach((otro) => (otro.hidden = otro !== cartel));
      capa.hidden = false;
      quienAbrio = boton;
      cartel.querySelector<HTMLButtonElement>('[data-cerrar-cartel]')?.focus();
    };

    document
      .querySelectorAll<HTMLButtonElement>('[data-buscado]')
      .forEach((boton) => boton.addEventListener('click', () => abrir(boton)));

    capa
      .querySelectorAll<HTMLButtonElement>('[data-cerrar-cartel]')
      .forEach((boton) => boton.addEventListener('click', cerrar));

    // Pulsar el fondo cierra; pulsar la tarjeta no.
    capa.addEventListener('click', (evento) => {
      if (evento.target === capa) cerrar();
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !capa.hidden) cerrar();
    });
  }
</script>
