---
import { Image } from 'astro:assets';
// El fichero es WebP aunque el diseno lo entregue como .jpg: se guarda con su
// extension real para que Astro no tenga que adivinar el formato.
import senorio from '../assets/senorio.webp';
import { ofuscar } from '../lib/contacto';
import { GIMNASIOS, HUECOS } from '../data/pokedex';

const MAPA = 'https://maps.app.goo.gl/KQpEZoszp1jsFZWA9';

// Totales de los dos juegos, para que el script pueda calcular el porcentaje
// sin volver a importar las listas enteras al navegador.
const HUECOS_TOTALES = HUECOS.length;
const MEDALLAS_TOTALES = GIMNASIOS.filter((g) => !g.bloqueado).length;

// Los telefonos no viven en el repositorio: entran en tiempo de build desde
// variables de entorno (.env en local, secretos de Actions en CI). Ademas se
// emiten codificados; ver src/lib/contacto.ts.
const definidos = [
  { nombre: 'Lucía', variable: 'TEL_LUCIA', telefono: import.meta.env.TEL_LUCIA },
  { nombre: 'Manuel', variable: 'TEL_MANUEL', telefono: import.meta.env.TEL_MANUEL },
];

// El bloque CONTACTO es contenido esencial de la invitacion: si faltan los
// telefonos se corta el build a proposito. Asi un despliegue mal configurado
// falla y deja en pie la version anterior, en vez de publicar la web sin
// forma de contactar con nosotros.
const faltan = definidos.filter((c) => !c.telefono).map((c) => c.variable);
if (faltan.length > 0) {
  throw new Error(
    `[Informacion] Faltan ${faltan.join(' y ')}. Crea un .env local ` +
      '(ver README) o define los secretos del repositorio en Actions.',
  );
}

const contactos = definidos.map((c) => ({
  nombre: c.nombre,
  codigo: ofuscar(c.telefono as string),
}));
---

<section class="info">
  <div class="divisor"><i></i></div>

  <div class="bloque">
    <h2>CUÁNDO</h2>
    <p class="dato">Sábado 26 de diciembre de 2026</p>
    <h2 class="segundo">HORARIO</h2>
    <p class="detalle">17:30 h · Ceremonia</p>
  </div>

  <div class="bloque">
    <h2>DÓNDE</h2>
    <p class="dato">Señorío de Nevada</p>
    <p class="detalle">Ctra de Conchar, s/n · 18659 Granada</p>
    <a class="boton" href={MAPA} target="_blank" rel="noopener">Cómo llegar</a>
    <p class="parrafo">
      Señorío de Nevada es una bodega y hotel en el Valle de Lecrín, entre viñedos y con Sierra
      Nevada al fondo. Ese día dispondremos de la totalidad del espacio. Incluye parking para todos
      los invitados.
    </p>
    <div class="marco-foto">
      <Image src={senorio} alt="Señorío de Nevada" width={800} loading="lazy" />
    </div>
  </div>

  <div class="bloque">
    <h2>NUESTRA HISTORIA</h2>
    <p class="detalle">
      ¡Conoce cómo se gestó el evento navideño del 2026, con arte, música y vídeos!
    </p>
    <a class="boton" href="#historia" data-ir-a="historia">Conoce nuestra historia</a>
  </div>

  <div class="bloque">
    <h2>TU POKÉDEX</h2>
    <p class="detalle">
      ¡Hazte con todos! Fotografíate con los invitados y completa tu colección.
    </p>
    {/* Solo aparece cuando ya hay algo que contar; lo rellena el script */}
    <div class="avance" data-avance="pokedex" data-total={HUECOS_TOTALES} hidden>
      <div class="cabecera-avance">
        <span data-etiqueta></span>
        <span class="cifra" data-cifra></span>
      </div>
      <div class="barra-avance"><div data-barra></div></div>
    </div>
    <a class="boton" href="#pokedex" data-ir-a="pokedex">Abrir tu Pokédex</a>
  </div>

  <div class="bloque">
    <h2>LOS GIMNASIOS</h2>
    <p class="detalle">
      Retos del día. Consigue todas las medallas y conviértete en campeón de la Liga.
    </p>
    <div class="avance" data-avance="gimnasios" data-total={MEDALLAS_TOTALES} hidden>
      <div class="cabecera-avance">
        <span data-etiqueta>Medallas</span>
        <span class="cifra" data-cifra></span>
      </div>
      <div class="barra-avance"><div data-barra></div></div>
    </div>
    <a class="boton" href="#gimnasios" data-ir-a="gimnasios">Ver los retos</a>
  </div>

  <div class="bloque">
    <h2>VUESTRAS FOTOS</h2>
    <p class="detalle">
      Sube las fotos que hagas al álbum compartido y guarda el QR: aquí publicaremos las mejores.
    </p>
    <a class="boton" href="#album" data-ir-a="album">Ir al álbum</a>
  </div>

  <div class="bloque">
    <h2>DRESS CODE</h2>
    <p class="dato">Etiqueta</p>
    <p class="parrafo pegado">
      Ropa elegante para una fiesta pero cómoda para que podáis disfrutar. Se admite cualquier
      color, sobre todo los navideños. No se admite color blanco (nos ha obligado la sociedad).
    </p>
  </div>

  <div class="bloque">
    <h2>CONTACTO</h2>
    <div class="contactos">
      {
        contactos.map((c) => (
          <a class="contacto" data-tel={c.codigo} aria-label={`Llamar a ${c.nombre}`}>
            <span>{c.nombre}</span>
            <span class="numero">··· ··· ···</span>
          </a>
        ))
      }
    </div>
    <noscript>
      <p class="detalle sin-js">
        Activa JavaScript para ver los teléfonos, o escríbenos desde el formulario de confirmación.
      </p>
    </noscript>
  </div>
</section>

<script>
  import { revelar, telefonoParaLeer } from '../lib/contacto';
  import { CLAVE_FOTOS } from '../lib/pokedex';
  import { leerMedallas } from '../lib/medallas';

  // Deshace la codificacion del build y monta el enlace real. Se ejecuta en el
  // navegador, asi que el numero nunca aparece en el HTML que se sirve.
  document.querySelectorAll<HTMLAnchorElement>('.contacto[data-tel]').forEach((enlace) => {
    const codigo = enlace.dataset.tel;
    if (!codigo) return;

    try {
      const tel = revelar(codigo);
      enlace.href = `tel:${tel}`;
      const numero = enlace.querySelector('.numero');
      if (numero) numero.textContent = telefonoParaLeer(tel);
    } catch {
      // Codigo corrupto: se deja el marcador de puntos en lugar de romper la pagina.
    }
  });

  // ------------------------------------------------- avance de los dos juegos
  //
  // El diseno ata estas barras a haber iniciado sesion, pero aqui los
  // gimnasios no piden cuenta, asi que la regla es otra y vale para los dos:
  // se ensenan cuando hay algo que ensenar. Un "0 %" nada mas abrir la
  // invitacion seria ruido, y ademas delataria el juego a quien aun no ha
  // entrado.
  const contarFotos = () => {
    try {
      const datos: unknown = JSON.parse(localStorage.getItem(CLAVE_FOTOS) || '{}');
      return datos && typeof datos === 'object' ? Object.keys(datos).length : 0;
    } catch {
      return 0;
    }
  };

  const pintarAvance = (
    nombre: string,
    hechos: number,
    // La Pokedex se cuenta en porcentaje y los gimnasios en medallas, igual
    // que dentro de cada pantalla: la cifra grande tiene que decir lo mismo
    // aqui y alli para que no parezcan dos marcadores distintos.
    formato: (hechos: number, total: number) => { etiqueta: string; cifra: string },
  ) => {
    const bloque = document.querySelector<HTMLElement>(`[data-avance="${nombre}"]`);
    if (!bloque) return;

    const total = Number(bloque.dataset.total) || 0;
    if (hechos <= 0 || total <= 0) {
      bloque.hidden = true;
      return;
    }

    const { etiqueta, cifra } = formato(hechos, total);
    const destinoEtiqueta = bloque.querySelector<HTMLElement>('[data-etiqueta]');
    const destinoCifra = bloque.querySelector<HTMLElement>('[data-cifra]');
    const barra = bloque.querySelector<HTMLElement>('[data-barra]');

    if (destinoEtiqueta) destinoEtiqueta.textContent = etiqueta;
    if (destinoCifra) destinoCifra.textContent = cifra;
    if (barra) barra.style.width = `${Math.round((hechos / total) * 100)}%`;
    bloque.hidden = false;
  };

  const refrescar = () => {
    pintarAvance('pokedex', contarFotos(), (hechos, total) => ({
      etiqueta: `${hechos} de ${total} atrapados`,
      cifra: `${Math.round((hechos / total) * 100)}%`,
    }));

    pintarAvance('gimnasios', Object.values(leerMedallas()).filter(Boolean).length, (h, t) => ({
      etiqueta: 'Medallas',
      cifra: `${h} / ${t}`,
    }));
  };

  refrescar();

  // Las vistas del juego y la invitacion son la misma pagina, asi que volver
  // de la Pokedex no recarga nada. Los propios juegos avisan cuando cambia su
  // avance, y ese aviso llega tambien mientras su pantalla esta oculta.
  window.addEventListener('lm:avance', refrescar);
</script>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 10px 28px 26px;
  }

  .bloque {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h2 {
    margin: 0;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.24em;
    color: var(--dorado-oscuro);
  }

  h2.segundo {
    margin-top: 10px;
  }

  .dato {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
  }

  .detalle {
    margin: 0;
    font-size: 17px;
    line-height: 1.35;
    color: var(--texto-suave);
  }

  .boton {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 8px;
    border: 1px solid var(--dorado);
    color: var(--dorado-oscuro);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boton:hover {
    background: rgba(163, 121, 42, 0.08);
    color: var(--dorado-oscuro);
  }

  /* Bajo un titular corto como "Etiqueta" el hueco de 12px se abre demasiado. */
  .parrafo.pegado {
    margin-top: 4px;
  }

  .parrafo {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .marco-foto {
    margin-top: 14px;
    padding: 5px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
  }

  .marco-foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .avance {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
  }

  .cabecera-avance {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 14px;
    color: var(--texto-suave);
  }

  .cifra {
    font-size: 18px;
    font-weight: 600;
    color: var(--dorado-oscuro);
  }

  .barra-avance {
    height: 6px;
    border: 0.5px solid var(--dorado);
    background: rgba(255, 250, 238, 0.6);
  }

  .barra-avance div {
    width: 0;
    height: 100%;
    background: var(--dorado-oscuro);
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .barra-avance div {
      transition: none;
    }
  }

  .contactos {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 18px;
  }

  .contactos a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    border-bottom: 0.5px solid rgba(163, 121, 42, 0.4);
    color: var(--texto);
  }

  /* El href lo pone el script al cargar, asi que el cursor no llega solo. */
  .contactos a[href] {
    cursor: pointer;
  }

  .numero {
    color: var(--dorado-oscuro);
    font-variant-numeric: tabular-nums;
  }

  .sin-js {
    margin-top: 10px;
  }
</style>
