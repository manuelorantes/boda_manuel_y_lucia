---
import { Image } from 'astro:assets';
import habitacion from '../assets/habitacion.jpg';

/**
 * Ficha del alojamiento incluido en la entrada VIP.
 *
 * Vive en su propio componente porque la ven dos sitios: el paso de
 * alojamiento de la confirmacion y la pregunta frecuente de la FAQ VIP. Las
 * horas y el desayuno se escriben una sola vez: si cambia el check-in, se
 * cambia aqui y los dos sitios quedan al dia.
 *
 * Solo debe montarse desde la entrada VIP. La general no renderiza nada de
 * alojamiento, ni siquiera oculto.
 */
---

<div class="ficha">
  <div class="marco-foto">
    <Image src={habitacion} alt="Habitación del Señorío de Nevada" width={800} loading="lazy" />
  </div>

  <dl class="estancia">
    <div>
      <dt>Entrada a la habitación</dt>
      <dd>Sábado 26 · 14:00 h</dd>
    </div>
    <div>
      <dt>Salida</dt>
      <dd>Domingo 27 · 12:00 h</dd>
    </div>
    <div>
      <dt>Desayuno</dt>
      <dd>Incluido</dd>
    </div>
  </dl>
</div>

<style>
  .ficha {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .marco-foto {
    padding: 4px;
    border: 1px solid var(--dorado);
    background: rgba(255, 250, 238, 0.55);
  }

  .marco-foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .estancia {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: 15px;
    color: var(--texto-suave);
  }

  .estancia > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 0.5px solid rgba(163, 121, 42, 0.4);
  }

  /* La ultima fila cierra contra el texto de abajo, sin raya suelta. */
  .estancia > div:last-child {
    border-bottom: none;
  }

  .estancia dt {
    flex: none;
  }

  .estancia dd {
    margin: 0;
    font-size: 17px;
    color: var(--texto);
    text-align: right;
  }
</style>
